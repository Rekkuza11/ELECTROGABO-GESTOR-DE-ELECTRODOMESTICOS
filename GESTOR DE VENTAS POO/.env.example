# ──────────────────────────────────────────────────────────────────────────────
# ElectroGabo — Plantilla de variables de entorno (.env.example)
#
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo a ".env"
#   2. Rellena los valores reales de tu entorno
#   3. Nunca subas el archivo .env al repositorio (ya está en .gitignore)
# ──────────────────────────────────────────────────────────────────────────────

DB_USER=tu_usuario_de_bd
DB_PASSWORD=tu_contraseña_de_bd
DB_HOST=tu_host_de_bd
DB_NAME=base_datos_electrogabo
DB_PORT=3306
DB_SSL_CA=certs/isrgrootx1.pem

# Clave secreta usada para el HMAC de contraseñas.
# Genera un valor aleatorio fuerte: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=cambia_esto_por_un_valor_aleatorio_seguro
